# Include inside nginx's http {}. Replace the hostname and certificate paths.
limit_req_zone $binary_remote_addr zone=translator_api:10m rate=5r/s;
server {
    listen 443 ssl;
    server_name YOUR_API_HOST;
    ssl_certificate /YOUR_CERT/fullchain.pem;
    ssl_certificate_key /YOUR_CERT/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    client_body_timeout 10s;
    location / {
        limit_req zone=translator_api burst=10 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_read_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
